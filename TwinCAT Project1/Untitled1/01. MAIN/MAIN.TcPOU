<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="MAIN" Id="{dec5b1ca-8e16-4f49-8efb-57a750654862}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*** CONTROLLERS: MAIN LOGIC MODULARIZED ***)

// Reactor temperature
ReactorTemperatureController(
						temperatureUpper := GVL_IO.reactorTemperatureUpper,
						temperatureLower := GVL_IO.reactorTemperatureLower,
						contactor => GVL_IO.reactorTemperatureContactor);

// Reactor level/pressure
ReactorLevelAndPressureController(
					serialCommData := SerialCommunicationController.SerialCommReadData,
					stop := SafetyController.stop,
					levelHigh := GVL_IO.reactorLevelHigh,
					co2ConsumptionLimitExceeded :=  ReactorFlowController._closeOnOffValve,
					modeledValvePosition := ReactorFlowController.ModeledValvePercentage,
					flowMpcEnabled :=  ProcessViewBindings.FlowControlCommands.enableFlowMpc,
					slurryInletValve => GVL_IO.reactorInletValve,
					slurryOutletValve => GVL_IO.reactorOutletValve,
					extractiveOutletOnOffValve => GVL_IO.extractiveOutletOnOffValve,
					extractiveOutletControlValveClose => GVL_IO.extractiveOutletControlValveClose,
					extractiveOutletControlValveOpen => GVL_IO.extractiveOutletControlValveOpen);
					
// Reactor flow
ReactorFlowController(
					serialCommData := SerialCommunicationController.SerialCommReadData,
					flowControlValveOpening := ReactorLevelAndPressureController.ControlValveOpening,
					serialCommReadData := SerialCommunicationController.SerialCommReadData);
					
// Data acquisition
DataAcquisitionController(
					slurryOutletValveOpen := GVL_IO.reactorOutletValve,
					automaticExtractionStateActive := ReactorLevelAndPressureController.automaticExtractionState = E_AutomaticExtractionState.FILLING_ACTIVE);

{IF NOT defined (Simulation)}
// Persistent data saving
VariablePersistenceController();
{END_IF}

// Serial communication
SerialCommunicationController();

// Safety
SafetyController();

(*** VISUALIZATION BINDINGS: DATA TRANSFER FROM/TO UI ***)

// MainScreen in
MainScreenBindings(
				matlabValues := DataAcquisitionController.MatlabHmiValues,
				SerialCommReadData := SerialCommunicationController.SerialCommReadData,
				CalibrateDone := ReactorLevelAndPressureController.CalibrateDone,
				Stop :=  SafetyController.stop,
				ReactorPressure := ReactorLevelAndPressureController.iPressureScaledValue,
				OnOffValvePressureLimit := ParameterViewBindings.onOffValvePressureLimit);
// MainScreen out
ReactorTemperatureController.autoControlSelected := MainScreenBindings.autoControlSelected;
ReactorTemperatureController.temperatureSetpoint := MainScreenBindings.temperatureSetpoint;
ReactorTemperatureController.manualControlPercentage := MainScreenBindings.temperaturePidManualControlPercentage;
DataAcquisitionController.MatlabBtn := MainScreenBindings.matlabBtn;
GVL_OPC.OPC_ProgramNamePrefix := MainScreenBindings.programNamePrefix;
ReactorLevelAndPressureController.StartAutomaticExtraction := MainScreenBindings.startAutomaticExtraction;
SafetyController.buttonPressed := MainScreenBindings.estopButtonPressed;
SafetyController.resetPressed := MainScreenBindings.estopResetPressed;
SerialCommunicationController.SerialCommSetpoints := MainScreenBindings.serialCommSetpoints;
	
//ProcessView in			
ProcessViewBindings(
				reactorOutletValve := GVL_IO.reactorOutletValve,
				reactorInletValve := GVL_IO.reactorInletValve,
				lowerTemperature := ReactorTemperatureController.lowerTemperature,
				upperTemperature := ReactorTemperatureController.upperTemperature,
				reactorTemperatureContactor := GVL_IO.reactorTemperatureContactor,
				reactorLevelHigh := GVL_IO.reactorLevelHigh,
				reactorLevelLow := GVL_IO.reactorLevelLow,
				iPressureScaledValue := ReactorLevelAndPressureController.iPressureScaledValue,
				SerialCommReadData := SerialCommunicationController.SerialCommReadData,
				ExtractiveOnOffValveValues := ReactorLevelAndPressureController.ExtractiveOnOffValveValues,
				CalibrateDone := ReactorLevelAndPressureController.CalibrateDone,
				ControlValveOpening := ReactorLevelAndPressureController.ControlValveOpening,
				automaticExtractionState := ReactorLevelAndPressureController.automaticExtractionState,
				stop := SafetyController.stop,
				onOffValvePressureLimit := ParameterViewBindings.onOffValvePressureLimit,
				AutomaticExtractionValues := ReactorLevelAndPressureController.AutomaticExtractionValues,
				MeanReactorFlow := ReactorFlowController.MeanReactorFlow,
				ConsumedCo2Value := ReactorFlowController.ConsumedCo2Amount,
				FlowControlParameters := ParameterViewBindings.flowControlParameters,
				co2ConsumptionLimitExceeded := ReactorFlowController.Co2ConsumptionLimitExceeded,
				closeOnOffValve := ReactorFlowController.CloseOnOffValve,
				modeledMeanReactorFlow := ReactorFlowController.ModeledMeanReactorFlow,
				co2FlowDeviationPercentage := ReactorFlowController.FlowModelDeviationPercentage,
				controlValveOpen := GVL_IO.extractiveOutletControlValveOpen,
				controlValveClose := GVL_IO.extractiveOutletControlValveClose);
// ProcessView out
ReactorTemperatureController.temperatureContactorCommand := ProcessViewBindings.temperatureContactorCommand;
ReactorLevelAndPressureController.SlurryInValveCommand := ProcessViewBindings.SlurryInValveCommand;
ReactorLevelAndPressureController.PressureIntervals := ProcessViewBindings.PressureIntervals;
ReactorLevelAndPressureController.SlurryOutValveCommand := ProcessViewBindings.SlurryOutValveCommand;
ReactorLevelAndPressureController.ExtractiveOutOnOffValveCommand := ProcessViewBindings.ExtractiveOutOnOffValveCommand;
ReactorLevelAndPressureController.ExtractiveControlValveCommands := ProcessViewBindings.ExtractiveControlValveCommands;
ReactorFlowController.FlowControlParameters := ParameterViewBindings.flowControlParameters;
ReactorFlowController.FlowControlCommands := ProcessViewBindings.FlowControlCommands;
	
// ParameterView in			
ParameterViewBindings();
// ParameterView out
ReactorTemperatureController.pidControllerParameters := ParameterViewBindings.reactorTemperaturePidParameters;
ReactorLevelAndPressureController.AutomaticExtractionParameters := ParameterViewBindings.autoExtractionParameters;
ReactorLevelAndPressureController.PressureIntervals := ParameterViewBindings.pressureIntervals;
ReactorLevelAndPressureController.ExtractiveControlValveParameters := ParameterViewBindings.extractionValveParameters;


// Simulation
{IF defined (Simulation)}
	Simulation();
{END_IF}

]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="424" Count="115" />
      <LineId Id="251" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>