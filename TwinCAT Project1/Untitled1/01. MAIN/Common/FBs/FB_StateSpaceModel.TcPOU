<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_StateSpaceModel" Id="{dcf04b36-9606-4b0e-bcf8-fd602d1b7f4c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_StateSpaceModel
VAR
    nx : INT;
    nu : INT;
    ny : INT;
	
    x  		: ARRAY[1..15] OF LREAL;

    _A  : ARRAY[1..15,1..15] OF LREAL;
    _B  : ARRAY[1..15,1..15] OF LREAL;
    _C  : ARRAY[1..15,1..15] OF LREAL;
    _D  : ARRAY[1..15,1..15] OF LREAL;
    _K  : ARRAY[1..15] OF LREAL;

	_activateObserver : BOOL;
    bInit : BOOL;
	
	i,j,l : INT;
    xNext : ARRAY[1..15] OF LREAL;
    yPred : ARRAY[1..15] OF LREAL;

    e : LREAL;
END_VAR
VAR_OUTPUT
	y  : ARRAY[1..15] OF LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="getOutput" Id="{ccd21c9e-bce9-4b78-b3af-9dd4669553af}">
      <Declaration><![CDATA[METHOD PUBLIC GetOutput
VAR_OUTPUT
    Output : ARRAY[1..15] OF LREAL;
END_VAR
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR i:=1 TO ny DO
    Output[i] := y[i];
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="getState" Id="{6af0abee-6782-47d8-8b52-eaed0358b801}">
      <Declaration><![CDATA[METHOD GetState
VAR_OUTPUT
    State : ARRAY[1..15] OF LREAL;
END_VAR
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR i:=1 TO nx DO
    State[i] := x[i];
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{b1a1fbce-7488-459e-a918-05d26a30116b}">
      <Declaration><![CDATA[METHOD PUBLIC Init
VAR_INPUT
	activateObserver : BOOL;
END_VAR
VAR
    i,j : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
Reset();
//FOR i := 1 TO nx DO
//    x[i] := 0;
//    _K[i] := _K[i]; // keep
//END_FOR
_activateObserver := activateObserver;
bInit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="predict" Id="{c12546b3-a33b-4d4b-9a01-fcb29ea4ba69}">
      <Declaration><![CDATA[METHOD PUBLIC Predict
VAR_INPUT
    xIn : ARRAY[1..15] OF LREAL;
    u   : ARRAY[1..15] OF LREAL;
END_VAR
VAR_OUTPUT
    xOut : ARRAY[1..15] OF LREAL;
    yOut : ARRAY[1..15] OF LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
(* Calculate output *)

FOR i:=1 TO ny DO

    yOut[i] := 0.0;

    FOR j:=1 TO nx DO
        yOut[i] := yOut[i] + _C[i,j] * xIn[j];
    END_FOR

    FOR j:=1 TO nu DO
        yOut[i] := yOut[i] + _D[i,j] * u[j];
    END_FOR

END_FOR


(* Predict next state *)

FOR i:=1 TO nx DO

    xOut[i] := 0.0;

    FOR j:=1 TO nx DO
        xOut[i] := xOut[i] + _A[i,j] * xIn[j];
    END_FOR

    FOR j:=1 TO nu DO
        xOut[i] := xOut[i] + _B[i,j] * u[j];
    END_FOR

END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{32ca3dbd-498c-44f5-8aa8-3c942ba76c41}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR i:=1 TO 15 DO

    x[i] := 0.0;

    y[i] := 0.0;

END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="setState" Id="{361ca776-39b8-4fa5-878b-ae32d8a2a6d9}">
      <Declaration><![CDATA[METHOD setState : BOOL
VAR_INPUT
    State : ARRAY[1..15] OF LREAL;
END_VAR
VAR
    i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR i:=1 TO nx DO
    x[i] := State[i];
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="step" Id="{673a3b0c-a3cb-4aba-bf8c-343c4d6c442b}">
      <Declaration><![CDATA[METHOD PUBLIC Step
VAR_INPUT
    u      : ARRAY[1..15] OF LREAL;
    yMeas  : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Predict(
    xIn := x,
    u := u,
    xOut => xNext,
    yOut => yPred);

IF _activateObserver THEN

    e := yMeas - yPred[1];

    FOR l:=1 TO nx DO
        xNext[l] := xNext[l] + _K[l] * e;
    END_FOR

END_IF

FOR l:=1 TO nx DO
    x[l] := xNext[l];
END_FOR

FOR l:=1 TO ny DO
    y[l] := yPred[l];
END_FOR]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_StateSpaceModel">
      <LineId Id="9" Count="0" />
    </LineIds>
