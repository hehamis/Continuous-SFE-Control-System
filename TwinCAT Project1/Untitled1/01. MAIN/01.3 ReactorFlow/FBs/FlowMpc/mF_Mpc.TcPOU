	mF_Mpc_b_Kr: ARRAY[0..79] OF LREAL := [-0.00549463213607137, -0.012512212765038307, -0.020978748468306194, -0.030822367591893881, -0.04197328436307568, -0.05436376289748019, -0.067928081131178014, -0.082602494710805427, -0.098325200873325261, -0.11503630234561939, -0.13267777129273819, -0.15119341334230155, -0.17052883171125094, -0.19063139145989541, -0.21145018389697115, -0.23293599115824856, -0.25504125098006758, -0.27772002168806459, -0.30092794742026929, -0.32462222360269782, -0.34876156269454833, -0.37330616021911811, -0.39821766109560286, -0.42345912628601329, -0.44899499977054591, -0.47479107586387781, -0.500814466884017, -0.52703357118452587, -0.5534180415601555, -0.579938754035168, -0.60656777704289633, -0.63327834100438385, -0.66004480831326817, -0.68684264373341608, -0.71364838521518825, -0.74043961513560164, -0.76719493196707411, -0.79389392237887346, -0.8205171337748508, -0.84704604727052057, -0.0, -0.00549463213607137, -0.012512212765038307, -0.020978748468306194, -0.030822367591893881, -0.04197328436307568, -0.05436376289748019, -0.067928081131178014, -0.082602494710805427, -0.098325200873325261, -0.11503630234561939, -0.13267777129273819, -0.15119341334230155, -0.17052883171125094, -0.19063139145989541, -0.21145018389697115, -0.23293599115824856, -0.25504125098006758, -0.27772002168806459, -0.30092794742026929, -0.32462222360269782, -0.34876156269454833, -0.37330616021911811, -0.39821766109560286, -0.42345912628601329, -0.44899499977054591, -0.47479107586387781, -0.500814466884017, -0.52703357118452587, -0.5534180415601555, -0.579938754035168, -0.60656777704289633, -0.63327834100438385, -0.66004480831326817, -0.68684264373341608, -0.71364838521518825, -0.74043961513560164, -0.76719493196707411, -0.79389392237887346, -0.8205171337748508];
	mF_Mpc_b_Kx: ARRAY[0..5] OF LREAL := [-94.697209868566148, -76.658429265941407, 14.675975139264946, -88.657433230178924, -72.669379425301543, 13.828929091994425];
	mF_Mpc_b_Kv: ARRAY[0..163] OF LREAL := [0.00056669670975549417, 0.0, 0.00056454698882445426, 0.0, 0.00056171378115873051, 0.0, 0.000558163705311171, 0.0, 0.00055386753553876089, 0.0, 0.00054880019217074612, 0.0, 0.00054294073422952679, 0.0, 0.00053627235431904076, 0.0, 0.00052878237579336289, 0.0, 0.00052046225221626574, 0.0, 0.0005113075691205054, 0.0, 0.0005013180480736276, 0.0, 0.00049049755305511289, 0.0, 0.00047885409914771263, 0.0, 0.00046639986354384471, 0.0, 0.00045315119886594324, 0.0, 0.00043912864879766121, 0.0, 0.00042435696602082678, 0.0, 0.00040886513245104005, 0.0, 0.00039268638176276609, 0.0, 0.00037585822419273433, 0.0, 0.00035842247360838336, 0.0, 0.0003404252768260013, 0.0, 0.00032191714516109366, 0.0, 0.00030295298819136456, 0.0, 0.00028359214971052386, 0.0, 0.00026389844584892108, 0.0, 0.00024394020533476639, 0.0, 0.00022379031186741283, 0.0, 0.00020352624857185534, 0.0, 0.00018323014450123394, 0.0, 0.00016298882315171894, 0.0, 0.00014289385295169769, 0.0, 0.00012304159968467275, 0.0, 0.00010353328080272097, 0.0, 8.4475021584745662E-5, 0.0, 6.5977913091080226E-5, 0.0, 4.8158071863267726E-5, 0.0, 3.1136701315044024E-5, 0.0, 1.5040154757691293E-5, 0.0, 0.0, 0.0, 0.00053555728746709471, 0.0, 0.00053382324427473109, 0.0, 0.00053146079227706935, 0.0, 0.00052843338775287563, 0.0, 0.00052470868572418341, 0.0, 0.00052025852865698733, 0.0, 0.00051505893739729465, 0.0, 0.00050909010435874194, 0.0, 0.00050233638897594763, 0.0, 0.00049478631543576083, 0.0, 0.00048643257269655649, 0.0, 0.00047727201680372187, 0.0, 0.000467305675507485, 0.0, 0.00045653875518723315, 0.0, 0.0004449806500844704, 0.0, 0.00043264495384456181, 0.0, 0.00041954947336539828, 0.0, 0.00040571624494909787, 0.0, 0.00039117155275083024, 0.0, 0.00037594594951680251, 0.0, 0.0003600742796013881, 0.0, 0.0003435957042512962, 0.0, 0.0003265537291425811, 0.0, 0.00030899623415416288, 0.0, 0.000290975505359383, 0.0, 0.00027254826921493307, 0.0, 0.0002537757289242889, 0.0, 0.00023472360295053224, 0.0, 0.0002154621656511635, 0.0, 0.00019606629000518805, 0.0, 0.00017661549240039669, 0.0, 0.00015719397944635572, 0.0, 0.00013789069677617256, 0.0, 0.00011879937979760023, 0.0, 0.00010001860635149635, 0.0, 8.1651851233045634E-5, 0.0, 6.3807542528496311E-5, 0.0, 4.6599119717442149E-5, 0.0, 3.0145093487901879E-5, 0.0, 1.4569107208607044E-5, 0.0, 0.0, 0.0];
	mF_Mpc_b_Hinv: ARRAY[0..8] OF LREAL := [47.969269526682837, -48.953924995564833, 0.0, -48.953924995564833, 52.498049705821067, 0.0, 0.0, 0.0, 9.9999999999999974E-6];
	b_Ac: ARRAY[0..11] OF SINT := [-1, -1, 1, 1, 0, -1, 0, 1, 0, 0, 0, 0];
	mF_Mpc_b_Linv: ARRAY[0..8] OF LREAL := [1.5232224524270519, -6.75640902307616, 0.0, 0.0, 7.2455537887604606, 0.0, 0.0, 0.0, 0.003162277660168379];
	mF_Mpc_e_a: ARRAY[0..8] OF LREAL := [0.98951110734634373, -0.012366186463409425, 0.0, 0.036765047017224647, 0.96487287051035242, 0.0, 0.0, 0.0, 1.0];
	mF_Mpc_f_a: ARRAY[0..2] OF LREAL := [-2.5204929819596814E-5, -0.00021989087306674475, 0.0];
	mF_Mpc_g_a: ARRAY[0..5] OF LREAL := [-1.6729314626197398E-6, -5.345511968919141E-6, 0.0, 0.0, 0.0, 0.0];
