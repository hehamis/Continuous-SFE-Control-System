        (* '<S24>:1:19' coder.extrinsic('mpcblock_refmd_single_mex'); *)
        (* Inputs (in BlockDataType except iA) *)
        (* xk:         current state (either x[k|k-1] from built-in KF or external x[k|k]) *)
        (* '<S24>:1:23' xk = convertDataType(xk0,isDouble); *)
        (* '<S24>:1:250' if isDouble *)
        (* convert an input signal to double precision when necessary *)
        (* '<S24>:1:252' if isa(u,'double') *)
        (* '<S24>:1:253' y = u; *)
        (* old_u:      last mv (calculated by MPC) *)
        (* '<S24>:1:25' old_u = convertDataType(old_u0,isDouble); *)
        (* '<S24>:1:250' if isDouble *)
        (* convert an input signal to double precision when necessary *)
        (* '<S24>:1:252' if isa(u,'double') *)
        (* '<S24>:1:253' y = u; *)
        (* ym:         current measured output (used only with built-in KF) *)
        (* '<S24>:1:27' ym = convertDataType(ym0,isDouble); *)
        (* '<S24>:1:250' if isDouble *)
        (* convert an input signal to double precision when necessary *)
        (* '<S24>:1:252' if isa(u,'double') *)
        (* '<S24>:1:253' y = u; *)
        (* ref:        output reference *)
        (* '<S24>:1:29' ref = convertDataType(ref0,isDouble); *)
        (* '<S24>:1:250' if isDouble *)
        (* convert an input signal to double precision when necessary *)
        (* '<S24>:1:252' if isa(u,'double') *)
        (* '<S24>:1:253' y = u; *)
        (* md:         measured disturbance *)
        (* '<S24>:1:31' md = convertDataType(md0,isDouble); *)
        (* '<S24>:1:250' if isDouble *)
        (* convert an input signal to double precision when necessary *)
        (* '<S24>:1:252' if isa(u,'double') *)
        (* '<S24>:1:253' y = u; *)
        (* umin:       run-time MV bound *)
        (* '<S24>:1:33' umin = convertDataType(umin0,isDouble); *)
        (* umax:       run-time MV bound *)
        (* '<S24>:1:35' umax = convertDataType(umax0,isDouble); *)
        (* ymin:       run-time OV bound *)
        (* '<S24>:1:37' ymin = convertDataType(ymin0,isDouble); *)
        (* ymax:       run-time OV bound *)
        (* '<S24>:1:39' ymax = convertDataType(ymax0,isDouble); *)
        (* E:          run-time mixed constraints *)
        (* '<S24>:1:41' E = convertDataType(E0,isDouble); *)
        (* F:          run-time mixed constraints *)
        (* '<S24>:1:43' F = convertDataType(F0,isDouble); *)
        (* G:          run-time mixed constraints *)
        (* '<S24>:1:45' G = convertDataType(G0,isDouble); *)
        (* S:          run-time mixed constraints *)
        (* '<S24>:1:47' S = convertDataType(S0,isDouble); *)
        (* switch_in:  if it matches "enable_value", MPC is active in control *)
        (* '<S24>:1:49' switch_in = int32(switch_in0); *)
        (* ext_mv:     external last mv (actual) *)
        (* '<S24>:1:51' ext_mv = convertDataType(ext_mv0,isDouble); *)
        (* MVtarget:   MV reference *)
        (* '<S24>:1:53' MVtarget = convertDataType(MVtarget0,isDouble); *)
        (* ywt:        run-time OV weights *)
        (* '<S24>:1:55' ywt = convertDataType(ywt0,isDouble); *)
