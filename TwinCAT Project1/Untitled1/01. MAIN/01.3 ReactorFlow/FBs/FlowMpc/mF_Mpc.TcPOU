                                                    b_H[iSave] := b_H[iSave] - (TL[(3 * k_k) + 1] * TL[(3 * k_k) + v_i]);
                                                    k_k := k_k + 1;
                                                END_WHILE;
                                                b_H[v_i + 3] := b_H[iSave];
                                                v_i := v_i + 1;
                                            END_WHILE;
                                            v_i := 2;
                                            WHILE (v_i + 1) <= mF_Mpc_degrees DO
                                                iSave := (3 * v_i) + 2;
                                                b_H[iSave] := 0.0;
                                                k_k := nA;
                                                WHILE (k_k + 1) <= mF_Mpc_degrees DO
                                                    b_H[iSave] := b_H[iSave] - (TL[(3 * k_k) + 2] * TL[(3 * k_k) + v_i]);
                                                    k_k := k_k + 1;
                                                END_WHILE;
                                                b_H[v_i + 6] := b_H[iSave];
                                                v_i := v_i + 1;
                                            END_WHILE;
                                            iSave := 0;
                                            WHILE iSave <= (nA - 1) DO
                                                b_D[3 * iSave] := 0.0;
                                                k_k := iSave;
                                                WHILE (k_k + 1) <= nA DO
                                                    b_D[3 * iSave] := (RLinv[(3 * k_k) + iSave] * TL[3 * k_k]) + b_D[3 * iSave];
                                                    k_k := k_k + 1;
                                                END_WHILE;
                                                v_i := (3 * iSave) + 1;
                                                b_D[v_i] := 0.0;
                                                k_k := iSave;
                                                WHILE (k_k + 1) <= nA DO
                                                    b_D[v_i] := (TL[(3 * k_k) + 1] * RLinv[(3 * k_k) + iSave]) + b_D[v_i];
                                                    k_k := k_k + 1;
                                                END_WHILE;
                                                v_i := (3 * iSave) + 2;
                                                b_D[v_i] := 0.0;
                                                k_k := iSave;
                                                WHILE (k_k + 1) <= nA DO
                                                    b_D[v_i] := (TL[(3 * k_k) + 2] * RLinv[(3 * k_k) + iSave]) + b_D[v_i];
                                                    k_k := k_k + 1;
                                                END_WHILE;
                                                iSave := iSave + 1;
                                            END_WHILE;
                                            exitg4 := 1;
                                        END_IF;

                                    UNTIL NOT(exitg4 = 0)
                                    END_REPEAT;

                                    IF kDrop <= 0 THEN 
                                        i := -2;
                                        exitg1 := 1;
                                    ELSE 

                                        FOR k_k := 0 TO 8 DO 
                                            b_U[k_k] :=  -b_H[k_k];
                                        END_FOR;

                                        cVal := 0.0;
                                        t := 0.0;
                                        z_0 := 0.0;

                                        FOR k_k := 0 TO 2 DO 
                                            cMin := mF_Mpc_b_Ac[(244 * k_k) + tmp];
                                            cVal := (b_U[3 * k_k] * cMin) + cVal;
                                            t := (b_U[(3 * k_k) + 1] * cMin) + t;
                                            z_0 := (b_U[(3 * k_k) + 2] * cMin) + z_0;
                                        END_FOR;

                                        z[2] := z_0;
                                        z[1] := t;
                                        z[0] := cVal;
                                        kDrop := 0;
                                        WHILE kDrop <= (nA - 1) DO
                                            b_r[kDrop] := ((b_D[(3 * kDrop) + 1] * mF_Mpc_b_Ac[tmp + 244]) + (b_D[3 * kDrop] * mF_Mpc_b_Ac[tmp])) + (b_D[(3 * kDrop) + 2] * mF_Mpc_b_Ac[tmp + 488]);
                                            kDrop := kDrop + 1;
                                        END_WHILE;
                                        temp1 := TRUE;
                                    END_IF;

                                END_IF;


                                IF temp1 THEN 
                                    kDrop := 0;
                                    cMin := 0.0;
                                    DualFeasible := TRUE;
                                    ColdReset := TRUE;

                                    IF nA > 0 THEN 
                                        iSave := 0;
                                        REPEAT 
                                            exitg4 := 0;

                                            IF iSave <= (nA - 1) THEN 

                                                IF b_r[iSave] >= 1.0E-12 THEN 
                                                    ColdReset := FALSE;
                                                    exitg4 := 1;
                                                ELSE 
                                                    iSave := iSave + 1;
                                                END_IF;

                                            ELSE 
                                                exitg4 := 1;
                                            END_IF;

                                        UNTIL NOT(exitg4 = 0)
                                        END_REPEAT;
                                    END_IF;


                                    IF (nA <> 0) AND ( NOT ColdReset) THEN 
                                        v_i := 0;
                                        WHILE v_i <= (nA - 1) DO

                                            IF b_r[v_i] > 1.0E-12 THEN 
                                                cVal := a_1[iC[v_i] - 1] / b_r[v_i];

                                                IF (kDrop = 0) OR (cVal < rMin) THEN 
                                                    rMin := cVal;
                                                    kDrop := v_i + 1;
                                                END_IF;

                                            END_IF;

                                            v_i := v_i + 1;
                                        END_WHILE;

                                        IF kDrop > 0 THEN 
                                            cMin := rMin;
                                            DualFeasible := FALSE;
                                        END_IF;

                                    END_IF;

                                    t := mF_Mpc_b_Ac[tmp + 244];
                                    z_0 := mF_Mpc_b_Ac[tmp + 488];
                                    cVal := ((t * z[1]) + (z[0] * mF_Mpc_b_Ac[tmp])) + (z_0 * z[2]);

                                    IF cVal <= 0.0 THEN 
                                        cVal := 0.0;
                                        ColdReset := TRUE;
                                    ELSE 
                                        cVal := (b[tmp] - (((t * rtb_xest[1]) + (mF_Mpc_b_Ac[tmp] * rtb_xest[0])) + (z_0 * rtb_xest[2]))) / cVal;
                                        ColdReset := FALSE;
                                    END_IF;


                                    IF DualFeasible AND ColdReset THEN 
                                        i := -1;
                                        exitg1 := 1;
                                    ELSE 

                                        IF ColdReset THEN 
                                            t := cMin;
                                        ELSIF DualFeasible THEN 
                                            t := cVal;
                                        ELSIF cMin < cVal THEN 
                                            t := cMin;
                                        ELSE 
                                            t := cVal;
                                        END_IF;

                                        v_i := 0;
                                        WHILE v_i <= (nA - 1) DO
                                            a_1[iC[v_i] - 1] := a_1[iC[v_i] - 1] - (t * b_r[v_i]);

                                            IF iC[v_i] <= 244 THEN 

                                                IF a_1[iC[v_i] - 1] < 0.0 THEN 
                                                    a_1[iC[v_i] - 1] := 0.0;
                                                END_IF;

                                            END_IF;

                                            v_i := v_i + 1;
                                        END_WHILE;
                                        a_1[tmp] := a_1[tmp] + t;

                                        IF ABS(t - cMin) < 2.2204460492503131E-16 THEN 
                                            i0_DropConstraint(kDrop := kDrop, iA := rtb_iAout, nA := nA, iC := iC);
                                        END_IF;


                                        IF  NOT ColdReset THEN 
                                            rtb_xest[0] := (t * z[0]) + rtb_xest[0];
                                            rtb_xest[1] := (t * z[1]) + rtb_xest[1];
                                            rtb_xest[2] := (t * z[2]) + rtb_xest[2];

                                            IF ABS(t - cVal) < 2.2204460492503131E-16 THEN 

                                                IF nA = mF_Mpc_degrees THEN 
                                                    i := -1;
                                                    exitg1 := 1;
                                                ELSE 
                                                    nA := nA + 1;
                                                    iC[nA - 1] := tmp + 1;
                                                    kDrop := nA - 1;
                                                    REPEAT 
                                                        exitg4 := 0;

                                                        IF (kDrop + 1) > 1 THEN 
                                                            k_k := iC[kDrop - 1];

                                                            IF iC[kDrop] > k_k THEN 
                                                                exitg4 := 1;
                                                            ELSE 
                                                                iSave := iC[kDrop];
                                                                iC[kDrop] := k_k;
                                                                iC[kDrop - 1] := iSave;
                                                                kDrop := kDrop - 1;
                                                            END_IF;

                                                        ELSE 
                                                            exitg4 := 1;
                                                        END_IF;

                                                    UNTIL NOT(exitg4 = 0)
                                                    END_REPEAT;
                                                    rtb_iAout[tmp] := TRUE;
                                                    tmp := -1;
                                                    i := i + 1;
                                                END_IF;

                                            ELSE 
                                                i := i + 1;
                                            END_IF;

                                        ELSE 
                                            i := i + 1;
                                        END_IF;

                                    END_IF;

                                END_IF;

                            ELSE 
                                cMin := norm(x := rtb_xest);

                                IF ABS(cMin - Xnorm0) > 0.001 THEN 
                                    Xnorm0 := cMin;
                                    i0_abs_a(x := b);
                                    temp4 := i0_abs_a.y;
                                    i0_maximum2(x := temp4, y := 1.0);
                                    cTol := i0_maximum2.ex;
                                    cTolComputed := FALSE;
                                END_IF;

                                exitg1 := 2;
                            END_IF;

                        UNTIL NOT(exitg1 = 0)
                        END_REPEAT;

                        IF exitg1 = 1 THEN 
                            exitg2 := 1;
                        END_IF;

                    END_IF;

                ELSE 
                    exitg2 := 1;
                END_IF;

            UNTIL NOT(exitg2 = 0)
            END_REPEAT;
        END_IF;


        IF (i < 0) OR (i = 0) THEN 
            rtb_xest[0] := 0.0;
        END_IF;

        Xnorm0 := last_mv_DSTATE + rtb_xest[0];
        (* End of Outputs for SubSystem: '<Root>/mF_Mpc' *)
        (* '<S24>:1:231' if return_xseq || return_ovseq *)
        (* '<S24>:1:233' else *)
        (* '<S24>:1:234' yseq = zeros(p+1,ny,'like',rseq); *)
        (* '<S24>:1:235' xseq = zeros(p+1,nxQP,'like',rseq); *)
        (* '<S24>:1:238' if CustomEstimation *)
        (* '<S24>:1:240' else *)
        (* update x[k+1|k], assuming that above u and v will be applied. *)
        (* '<S24>:1:242' xk1 = A*xk + Bu*(u - uoff) + Bv*v + L*y_innov; *)
        (* '<S24>:1:244' xk1 = xk1 + xoff; *)
        (* Updated state must include offset *)
        (* return xest in original value *)
        (* '<S24>:1:247' xest = xest + xoff; *)
        (* Outputs for Atomic SubSystem: '<Root>/mF_Mpc' *)
        (* Update for Memory: '<S3>/Memory' *)

        FOR i := 0 TO 243 DO 
            Memory_PreviousInput[i] := rtb_iAout[i];
        END_FOR;

        (* End of Update for Memory: '<S3>/Memory' *)
        

        (* Update for UnitDelay: '<S3>/last_mv' incorporates:
         *  MATLAB Function: '<S23>/optimizer' *)
        last_mv_DSTATE := Xnorm0;
        (* End of Outputs for SubSystem: '<Root>/mF_Mpc' *)
        (* Outputs for Atomic SubSystem: '<Root>/mF_Mpc' *)
        (* MATLAB Function: '<S23>/optimizer' *)

        FOR k_k := 0 TO 2 DO 
            rtb_xest[k_k] := (((mF_Mpc_g_a[k_k + 3] * xk_idx_1) + (mF_Mpc_g_a[k_k] * xk_idx_0)) + (mF_Mpc_g_a[k_k + 6] * xk)) + (mF_Mpc_h_a[k_k] * Xnorm0);
        END_FOR;

        xk := 0.0;
        rMin := 0.0;

        FOR k_k := 0 TO 1 DO 
            cMin := v[k_k];
            xk := (mF_Mpc_i_a[3 * k_k] * cMin) + xk;
            rMin := (mF_Mpc_i_a[(3 * k_k) + 1] * cMin) + rMin;
        END_FOR;

        (* End of Outputs for SubSystem: '<Root>/mF_Mpc' *)
        (* Outputs for Atomic SubSystem: '<Root>/mF_Mpc' *)
        (* Update for Memory: '<S3>/last_x' incorporates:
         *  MATLAB Function: '<S23>/optimizer' *)
        last_x_PreviousInput[0] := (rtb_xest[0] + xk) + (-1.1590576263587683E-8 * y_innov);
        last_x_PreviousInput[1] := (rtb_xest[1] + rMin) + (-1.443048653146427E-7 * y_innov);
        last_x_PreviousInput[2] := rtb_xest_tmp + rtb_xest[2];
        (* Outport: '<Root>/valveCommand' incorporates:
         *  MATLAB Function: '<S23>/optimizer' *)
        valveCommand := Xnorm0;
        (* End of Outputs for SubSystem: '<Root>/mF_Mpc' *)
END_CASE;


]]></ST>
    </Implementation>
    <LineIds Name="mF_Mpc">
      <LineId Id="3" Count="1095" />
      <LineId Id="2" Count="0" />
