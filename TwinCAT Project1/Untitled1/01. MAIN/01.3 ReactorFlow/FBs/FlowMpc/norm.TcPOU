<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="norm" Id="{96c9b2b7-44b0-4460-8fd4-294effc86bc7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION norm : LREAL
VAR_INPUT
	x: ARRAY[0..2] OF LREAL;
END_VAR
VAR
	scale: LREAL;
	absxk: LREAL;
	t: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
scale := 3.3121686421112381E-170;
absxk := ABS(x[0]);

IF absxk > 3.3121686421112381E-170 THEN 
    norm := 1.0;
    scale := absxk;
ELSE 
    t := absxk / 3.3121686421112381E-170;
    norm := t * t;
END_IF;

absxk := ABS(x[1]);

IF absxk > scale THEN 
    t := scale / absxk;
    norm := ((norm * t) * t) + 1.0;
    scale := absxk;
ELSE 
    t := absxk / scale;
    norm := (t * t) + norm;
END_IF;

absxk := ABS(x[2]);

IF absxk > scale THEN 
    t := scale / absxk;
    norm := ((norm * t) * t) + 1.0;
    scale := absxk;
ELSE 
    t := absxk / scale;
    norm := (t * t) + norm;
END_IF;

norm := scale * SQRT(norm);

]]></ST>
    </Implementation>
    <LineIds Name="norm">
      <LineId Id="3" Count="35" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>