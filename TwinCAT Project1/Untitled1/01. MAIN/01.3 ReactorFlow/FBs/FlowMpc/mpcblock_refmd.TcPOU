<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="mpcblock_refmd" Id="{16714ffa-e731-4485-851a-ebaf5bcfa14e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK mpcblock_refmd
VAR_INPUT
	ref: LREAL;
	md: LREAL;
	b_yoff: LREAL;
	b_voff: LREAL;
	b_RYscale: LREAL;
	b_RMDscale: LREAL;
END_VAR
VAR_OUTPUT
	rseq: ARRAY[0..119] OF LREAL;
	vseq: ARRAY[0..241] OF LREAL;
	v: ARRAY[0..1] OF LREAL;
END_VAR
VAR
	i: DINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[

FOR i := 0 TO 241 DO 
    vseq[i] := 0.0;
END_FOR;


FOR i := 0 TO 120 DO 
    vseq[(i * 2) + 1] := 1.0;
END_FOR;


FOR i := 0 TO 119 DO 
    rseq[i] := (ref * b_RYscale) - b_yoff;
END_FOR;


FOR i := 0 TO 120 DO 
    vseq[i * 2] := (b_RMDscale * md) - b_voff;
END_FOR;

v[0] := vseq[0];
v[1] := vseq[1];

]]></ST>
    </Implementation>
    <LineIds Name="mpcblock_refmd">
      <LineId Id="3" Count="23" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>