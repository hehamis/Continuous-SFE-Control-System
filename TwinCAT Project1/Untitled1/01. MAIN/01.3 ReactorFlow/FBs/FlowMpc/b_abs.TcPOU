  <POU Name="b_abs" Id="{0159dded-4d7f-4927-9919-ac36ca379040}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK b_abs
VAR_INPUT
	x: ARRAY[0..2] OF LREAL;
END_VAR
VAR_OUTPUT
