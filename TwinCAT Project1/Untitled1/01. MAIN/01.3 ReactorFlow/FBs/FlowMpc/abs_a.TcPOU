<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="abs_a" Id="{dde1d8f0-9800-4053-b040-44a116a490ae}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK abs_a
VAR_INPUT
	x: ARRAY[0..243] OF LREAL;
END_VAR
VAR_OUTPUT
	y: ARRAY[0..243] OF LREAL;
END_VAR
VAR
	k: DINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[

FOR k := 0 TO 243 DO 
    y[k] := ABS(x[k]);
END_FOR;


]]></ST>
    </Implementation>
    <LineIds Name="abs_a">
      <LineId Id="3" Count="6" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>