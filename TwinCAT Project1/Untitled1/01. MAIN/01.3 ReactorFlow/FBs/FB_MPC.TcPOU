<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_MPC" Id="{73f87072-8d2a-4f02-ab17-106eb5a60a76}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MPC

VAR_INPUT
    enable : BOOL;

    setpoint : REAL;

    manipulatedVariableCurrent : LREAL;

    manipulatedVariableLimits : ARRAY[0..1] OF REAL;

    manipulatedVariableMaxReachTime : DINT;

    measuredDisturbance : LREAL;

    measuredVariableCurrent : REAL;
	
    controlBusy : BOOL;
END_VAR


VAR_IN_OUT
    Model : FB_StateSpaceModel;
END_VAR


VAR_OUTPUT
    ManipulatedVariableTarget : LREAL;

    ManipulatedVariableDelta : LREAL;
END_VAR


VAR
    xHat : ARRAY[1..15] OF LREAL;

    Yfree : ARRAY[1..50] OF LREAL;

    Ref : ARRAY[1..50] OF LREAL;

    Gradient : ARRAY[1..2] OF LREAL;

    DeltaU : ARRAY[1..2] OF LREAL;

    i : INT;
    j : INT;

    _MPC_Matrices : ST_MPC_Matrices;

    _predictionHorizon : INT := 50;
    _controlHorizon : INT := 2;

    rateLimit : LREAL;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//==========================================================
// ENABLE
//==========================================================

IF NOT enable THEN

    ManipulatedVariableTarget :=
        manipulatedVariableCurrent;

    ManipulatedVariableDelta := 0.0;

    RETURN;

END_IF;


//==========================================================
// GET ESTIMATED STATE FROM STATE OBSERVER
//
// The observer should already be using the measured process
// output to calculate xHat.
//==========================================================

Model.GetState(
    State => xHat
);


//==========================================================
// BUILD REFERENCE TRAJECTORY
//
// MATLAB:
//
// mpc1_RefSignal = setpoint
//
// The reference is constant over the prediction horizon.
//==========================================================

FOR i := 1 TO _predictionHorizon DO

    Ref[i] := TO_LREAL(setpoint);

END_FOR;


//==========================================================
// CALCULATE FREE RESPONSE
//
// Yfree = F * xHat
//
// This is the predicted output if no future changes
// in the manipulated variable are made.
//==========================================================

FOR i := 1 TO _predictionHorizon DO

    Yfree[i] := 0.0;

    FOR j := 1 TO 2 DO

        Yfree[i] :=
            Yfree[i]
            + _MPC_Matrices.gMPC_F[i,j]
            * xHat[j];

    END_FOR;

END_FOR;


//==========================================================
// CALCULATE GRADIENT
//
// Gradient = Phi' * (Yfree - Ref)
//==========================================================

FOR i := 1 TO _controlHorizon DO

    Gradient[i] := 0.0;

    FOR j := 1 TO _predictionHorizon DO

        Gradient[i] :=
            Gradient[i]
            + _MPC_Matrices.gMPC_Phi[j,i]
            * (Yfree[j] - Ref[j]);

    END_FOR;

END_FOR;


//==========================================================
// CALCULATE OPTIMAL DELTA-U
//
// DeltaU = -Hinv * Gradient
//
// DeltaU[1] is the first MPC control movement.
//==========================================================

FOR i := 1 TO _controlHorizon DO

    DeltaU[i] := 0.0;

    FOR j := 1 TO _controlHorizon DO

        DeltaU[i] :=
            DeltaU[i]
            - _MPC_Matrices.gMPC_Hinv[i,j]
            * Gradient[j];

    END_FOR;

END_FOR;


//==========================================================
// SELECT FIRST CONTROL MOVE
//
// Receding-horizon MPC only applies the first move.
//==========================================================

ManipulatedVariableDelta :=
    DeltaU[1];


//==========================================================
// CALCULATE ABSOLUTE MANIPULATED VARIABLE TARGET
//
// MATLAB MPC works with the manipulated variable itself.
//
// If:
//
// Current MV = 0.00
// DeltaU     = 1.20
//
// then:
//
// Target MV = 1.20
//
// If:
//
// Current MV = 0.50
// DeltaU     = 0.30
//
// then:
//
// Target MV = 0.80
//==========================================================

ManipulatedVariableTarget :=
    manipulatedVariableCurrent
    + ManipulatedVariableDelta;


//==========================================================
// ENFORCE MANIPULATED VARIABLE LOWER LIMIT
//
// Corresponds to:
//
// mpc1.MV(1).Min = 0;
//==========================================================

IF ManipulatedVariableTarget <
   TO_LREAL(manipulatedVariableLimits[0]) THEN

    ManipulatedVariableTarget :=
        TO_LREAL(manipulatedVariableLimits[0]);

END_IF;


//==========================================================
// ENFORCE MANIPULATED VARIABLE UPPER LIMIT
//
// Corresponds to:
//
// mpc1.MV(1).Max = 1.75;
//==========================================================

IF ManipulatedVariableTarget >
   TO_LREAL(manipulatedVariableLimits[1]) THEN

    ManipulatedVariableTarget :=
        TO_LREAL(manipulatedVariableLimits[1]);

END_IF;
]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{fcaad005-711a-4589-8d35-c274f92f7216}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	
	MPC_Matrices : ST_MPC_Matrices;
	PredictionHorizon : INT;
	ControlHorizon : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
_MPC_Matrices := MPC_Matrices;
_predictionHorizon := PredictionHorizon;
_controlHorizon := ControlHorizon;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_MPC">
      <LineId Id="4591" Count="185" />
      <LineId Id="114" Count="0" />
      <LineId Id="4832" Count="0" />
    </LineIds>
    <LineIds Name="FB_MPC.FB_init">
      <LineId Id="20" Count="0" />
      <LineId Id="23" Count="0" />
      <LineId Id="32" Count="1" />
    </LineIds>
  </POU>
</TcPlcObject>