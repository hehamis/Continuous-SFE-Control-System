<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_FlowMpcHandler" Id="{b89f0a14-0c2b-48c3-8c3c-0bbae460cc8d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FlowMpcHandler
VAR_INPUT
	enable : BOOL;
	flowSetpoint : REAL;
	pumpingPressureDelta : DINT;
	currentValvePosition : DINT;
	valveFullOpenTime : DINT := 25; // NOTE: Hardcoded! In the future from parameter view?
	flowModel	: FB_mF;
	measuredFlow : REAL;
END_VAR
VAR_OUTPUT
	modeledValvePercentage : DINT;
END_VAR
VAR
	maxValue : REAL := 1.75;
	flowMpc: mF_Mpc;				
	methodType : SINT;
	TON_StepInterval : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
//// Valve position percentage to rounds
//currentValvePosRounds := (TO_REAL(currentValvePosition)/100) * maxValue;
//TON_StepInterval(IN := enable, PT := T#1S);
//IF 	TON_StepInterval.Q THEN
//	flowMpc(
//		Enable := enable,
//		setpoint := flowSetpoint,
//		manipulatedVariableCurrent := currentValvePosRounds,
//		manipulatedVariableLimits := FlowValveLimits,
//		manipulatedVariableMaxReachTime := valveFullOpenTime,
//		measuredDisturbance := pumpingPressureDelta,
//		controlBusy := GVL_IO.extractiveOutletControlValveClose OR GVL_IO.extractiveOutletControlValveOpen,
//		measuredVariableCurrent := measuredFlow,
//		Model := flowModel);
//	IF NOT (GVL_IO.extractiveOutletControlValveClose OR GVL_IO.extractiveOutletControlValveOpen) THEN
//		modeledValvePercentage := TO_DINT((flowMpc.ManipulatedVariableTarget / maxValue) * 100);
//	END_IF
//	TON_StepInterval(IN := FALSE);
//END_IF

TON_StepInterval(IN := TRUE, PT := T#1S);

IF enable THEN
	IF TON_StepInterval.Q THEN
		flowMpc(
			ssMethodType:= 1, 
			flowCurrent:= measuredFlow, 
			flowSetpoint:= flowSetpoint, 
			pressureDifference:= TO_LREAL(pumpingPressureDelta), 
			valveCommand=> ,
			rtb_xest => );
		TON_StepInterval(IN := FALSE);
	END_IF
		
	IF NOT (GVL_IO.extractiveOutletControlValveClose OR GVL_IO.extractiveOutletControlValveOpen) THEN
		modeledValvePercentage := TO_DINT((flowMpc.valveCommand / maxValue) * 100);
	END_IF
ELSE
	flowMpc(
		ssMethodType:= 0);	
END_IF]]></ST>
    </Implementation>
