<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_Runtime" Id="{2c693863-3086-4693-805e-a6f5602c35ed}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Runtime
VAR_INPUT
	gotime: BOOL;
	settime: TIME;
	countdown: BOOL; 
	resetToTime : TIME;
END_VAR
VAR_OUTPUT
	elapsedtime: TIME;
	elapsed: BOOL;
END_VAR
VAR
	reset: BOOL;
	_resetTOTime : TIME;
	initial : BOOL := TRUE;
	presenttime: TIME;
	lasttime: TIME;
	cycletime: TIME := T#10MS;
	_testmode : BOOL;
	_testtime : TIME;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
_resetToTime := ResetToTime; 

IF initial AND NOT _testmode THEN
	elapsedtime := _resetToTime;
	initial := FALSE;
END_IF

// Get current time
IF _testmode THEN
	IF elapsedtime <> _testtime THEN
		elapsedtime := _testtime;
	ELSE
		IF gotime AND NOT countdown THEN
			elapsedtime := elapsedtime + cycletime;
		ELSIF NOT gotime AND countdown THEN
			elapsedtime := elapsedtime - cycletime;
		END_IF
	END_IF
ELSE
    presenttime := TIME();
END_IF

IF NOT reset AND NOT _testMode THEN
	IF (lasttime > presenttime) THEN (*overflow := true*);
		lasttime:= DWORD_TO_TIME(NOT TIME_TO_DWORD(lasttime));//+T#1MS;
		cycletime:= presenttime+lasttime;
	ELSE
		cycletime:= presenttime - lasttime;
	END_IF
ELSIF _testmode THEN
	cycletime := T#10MS;
ELSE
	elapsedtime:=_resetToTime;
	cycletime:=t#0s;
END_IF

lasttime:=presenttime;

IF gotime AND NOT countDown THEN
		elapsedtime := elapsedtime + cycletime;
ELSIF NOT gotime AND countdown THEN
	IF elapsedtime >= cycletime THEN 
		elapsedtime := elapsedtime - cycletime;
	ELSE
		elapsedtime := T#0S;
	END_IF
END_IF

IF settime < elapsedtime THEN
	elapsed:=TRUE;
	elapsedtime := settime;
ELSE
	elapsed:=FALSE;
END_IF

reset := FALSE;]]></ST>
    </Implementation>
    <Method Name="resetValues" Id="{42af8755-ea1f-418c-90bb-2c804aa4483e}">
      <Declaration><![CDATA[METHOD resetValues : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[reset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setTestMode" Id="{49000685-d0a8-4ee6-ad4a-48c7a4335da2}">
      <Declaration><![CDATA[METHOD setTestMode : BOOL
VAR_INPUT
	testtime : TIME;
	reset : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
_testmode := TRUE;
_testtime := testtime;
IF reset THEN
	resetValues();
END_IF]]></ST>
      </Implementation>
    </Method>
