<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_AutomaticExtractionStateMachine" Id="{fd3c0490-089c-4717-a34f-489c595512a4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AutomaticExtractionStateMachine
VAR_INPUT
	parameters : ST_AutomaticExtractionParameters;
	controlValveFullOpenTime : DINT;
	reactorPressure : DINT;
	pumpPressure : DINT;
	pumpSetpoint : DINT;
END_VAR
VAR_OUTPUT
	controlValveOpeningPercentage : DINT;
	decreasePumpSetpoint : BOOL;
	extractivePumpOn : BOOL;
	co2onOffValveClosed : BOOL;
	fillingActive : BOOL;
	automaticExtractionState : E_AutomaticExtractionState;
	automaticExtractionValues : ST_AutomaticExtractionValues;
	startCalibration : BOOL;
END_VAR
VAR
	TON_FillingTimer : TON;
	TON_WaitForSetpointReduce : TON;
	TON_WaitForPressureReduce : TON;
	TON_WaitForValve : TON;
	TON_KeepExtractivePumpOn : TON;
	startingReactorPRessure : DINT;
	startingPumpSetpoint : DINT;
	startingPumpPressure : DINT;
	endingPumpPressure : DINT;
	TON_FillingPumpWaitTimer : TON;
	decreaseReactorPressure : BOOL;
	increaseReactorPressure : BOOL;
	pressureTarget : DINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF NOT startCalibration THEN
	controlValveOpeningPercentage := parameters.controlValveOpeningValue;
END_IF

CASE automaticExtractionState OF 
	
	E_AutomaticExtractionState.AUTO_EXTRACTION: // Extraction step
	
		fillingActive := FALSE;
		startCalibration := FALSE;
		// Start filling timer. When filling timer exceeded, move to filling step
		TON_FillingTimer(
						IN := TRUE,
						PT := TO_TIME(parameters.fillingTime*1000));
		IF TON_FillingTimer.Q THEN
			TON_FillingTimer(IN := FALSE);
			startingPumpSetpoint := pumpSetpoint;
			automaticExtractionState := automaticExtractionState + 1;
		END_IF
		
	E_AutomaticExtractionState.REDUCE_PUMP_START_CALIB: // Reduce pump setpoint to 80 and start control valve calibration
		
		decreasePumpSetpoint := TRUE;
		startCalibration := TRUE;
		TON_WaitForSetpointReduce(
			IN := TRUE, 
			PT := TO_TIME(parameters.pumpSetpointReduceWaitTime *1000));
		IF TON_WaitForSetpointReduce.Q THEN 
			TON_WaitForSetpointReduce(IN := FALSE);
			automaticExtractionState := automaticExtractionState + 1;
		END_IF
		
	E_AutomaticExtractionState.WAIT_FOR_PRESSURE_REDUCE: // Wait for reactor pressure to reduce to setpoint (+offset)
	
		TON_WaitForPressureReduce(
			IN := TRUE,
			PT := TO_TIME(parameters.pumpPressureReduceWaitTime *1000)); 
		IF TON_WaitForPressureReduce.Q THEN
			IF reactorPressure <= (startingPumpSetpoint + parameters.refillStartPressureOffset) THEN
				TON_WaitForPressureReduce(IN := FALSE);
				automaticExtractionState := automaticExtractionState + 1;			
			END_IF
		END_IF
	E_AutomaticExtractionState.CLOSE_ON_OFF_VALVE:
	
		co2onOffValveClosed := TRUE;  // Close co2 on/off valve
		TON_FillingPumpWaitTimer(
			IN := TRUE, 
			PT := TO_TIME(parameters.pumpWaitTime*1000));
		IF TON_FillingPumpWaitTimer.Q THEN 
			TON_FillingPumpWaitTimer(IN := FALSE);
			startingReactorPressure := reactorPressure;
			startingPumpPressure := pumpPressure;
			automaticExtractionState := automaticExtractionState + 1;		
		END_IF
	
	E_AutomaticExtractionState.FILLING_ACTIVE: //  extractive pump on: stays on for a desired time
	
		extractivePumpOn := TRUE;
		TON_KeepExtractivePumpOn(
			IN := TRUE,
			PT := TO_TIME(parameters.pumpOnTime*1000));
		IF TON_KeepExtractivePumpOn.Q THEN
			TON_KeepExtractivePumpOn(IN := FALSE);
			endingPumpPressure := pumpPressure;
			automaticExtractionState := automaticExtractionState + 1;
		END_IF	
		
	E_AutomaticExtractionState.WAIT_FOR_PRESSURE_TO_SET: // Wait until reactor pressure is back to original setpoint + offset
		
		IF NOT decreaseReactorPressure AND NOT increaseReactorPressure THEN
			IF (reactorPressure >= (startingPumpSetpoint + parameters.refillEndPressureOffset)) THEN
				decreaseReactorPressure := TRUE;
				increaseReactorPressure := FALSE;
			ELSIF (reactorPressure < (startingPumpSetpoint + parameters.refillEndPressureOffset)) THEN
				increaseReactorPressure := TRUE;
				decreaseReactorPressure := FALSE;
			END_IF
		END_IF
		pressureTarget := startingPumpSetpoint + parameters.refillEndPressureOffset;
		IF decreaseReactorPressure THEN
			extractivePumpOn := FALSE;
			IF reactorPressure <= (startingPumpSetpoint + parameters.refillEndPressureOffset) THEN
				automaticExtractionState := automaticExtractionState + 1;
			END_IF			
		ELSIF increaseReactorPressure THEN
			IF reactorPressure >= (startingPumpSetpoint + parameters.refillEndPressureOffset) THEN
				extractivePumpOn := FALSE;
				automaticExtractionState := automaticExtractionState + 1;
			END_IF					
		END_IF
		
	E_AutomaticExtractionState.INCREASE_PUMP: // Pressure setpoint back to original

		decreaseReactorPressure := FALSE;
		increaseReactorPressure := FALSE;	
		decreasePumpSetpoint := FALSE;
		automaticExtractionState := automaticExtractionState + 1;
	
	E_AutomaticExtractionState.OPEN_ON_OFF_VALVE: // open on/off valve
	
		co2onOffValveClosed := FALSE;
		automaticExtractionState := 0;
		
END_CASE]]></ST>
    </Implementation>
    <Method Name="getCurrentTimer" Id="{a3ee8146-ea9a-4d24-ba76-03659dc48839}">
      <Declaration><![CDATA[METHOD getCurrentTimer : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CASE automaticExtractionState OF 
	
	E_AutomaticExtractionState.AUTO_EXTRACTION: // Extraction step

		automaticExtractionValues.currentTimer := TON_FillingTimer.PT;
		automaticExtractionValues.elapsedTime := TON_FillingTimer.ET;
		automaticExtractionValues.timeVisible := TRUE;
		
	E_AutomaticExtractionState.REDUCE_PUMP_START_CALIB: // Filling step: Control valve to a small opening

		automaticExtractionValues.currentTimer := TON_WaitForSetpointReduce.PT;
		automaticExtractionValues.elapsedTime := TON_WaitForSetpointReduce.ET;		
		automaticExtractionValues.timeVisible := TRUE;
	
	E_AutomaticExtractionState.WAIT_FOR_PRESSURE_REDUCE: // Set pump setpoint to 80 bar

		automaticExtractionValues.currentTimer := TON_WaitForPressureReduce.PT;
		automaticExtractionValues.elapsedTime := TON_WaitForPressureReduce.ET;		
		automaticExtractionValues.timeVisible := TRUE;	
		
	E_AutomaticExtractionState.CLOSE_ON_OFF_VALVE:
	
		automaticExtractionValues.currentTimer := TON_FillingPumpWaitTimer.PT;
		automaticExtractionValues.elapsedTime := TON_FillingPumpWaitTimer.ET;
		automaticExtractionValues.timeVisible := TRUE;

	E_AutomaticExtractionState.FILLING_ACTIVE: //  extractive pump on: stays on for a desired time
	
		automaticExtractionValues.currentTimer := TON_KeepExtractivePumpOn.PT;
		automaticExtractionValues.elapsedTime := TON_KeepExtractivePumpOn.ET;
		automaticExtractionValues.timeVisible := TRUE;
	
	E_AutomaticExtractionState.WAIT_FOR_PRESSURE_TO_SET: // Extractive pump turns off after pressure reaches the same as it was b4 turning on
		
		automaticExtractionValues.timeVisible := FALSE;	
		
	E_AutomaticExtractionState.INCREASE_PUMP: // Pressure setpoint back to original (+40bar) and open on/off valve

		automaticExtractionValues.timeVisible := FALSE;	
	
	E_AutomaticExtractionState.OPEN_ON_OFF_VALVE: // open control valve to desired value

		automaticExtractionValues.timeVisible := FALSE;	

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="resetState" Id="{bf1ce1ba-fd70-4c2a-963b-7e4edcae03f9}">
      <Declaration><![CDATA[METHOD resetState : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
automaticExtractionState := 0;
TON_FillingTimer(IN :=FALSE);
TON_WaitForValve(IN :=FALSE);
TON_WaitForSetpointReduce(IN := FALSE);
TON_WaitForPressureReduce(IN := FALSE);
TON_KeepExtractivePumpOn(IN :=FALSE);
co2onOffValveClosed := FALSE;
decreasePumpSetpoint := FALSE;
extractivePumpOn := FALSE;
fillingActive := FALSE;
startCalibration := FALSE;
decreaseReactorPressure := FALSE;
increaseReactorPressure := FALSE;]]></ST>
      </Implementation>
    </Method>
