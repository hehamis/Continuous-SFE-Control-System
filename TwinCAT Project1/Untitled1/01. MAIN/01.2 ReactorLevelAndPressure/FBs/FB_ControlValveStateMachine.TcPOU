<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_ControlValveStateMachine" Id="{927e7969-28c8-49a4-a417-97545e2fb919}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ControlValveStateMachine
VAR_INPUT
	controlValveCommands : ST_ExtractiveControlValveCommands;
	controlValveParameters : ST_ExtractiveControlValveParameters;
	startCalibrationExternal : BOOL;
END_VAR
VAR_OUTPUT
	closeControlValve : BOOL;
	openControlValve : BOOL;
	currentControlValveOpenPercentage : DINT;
	calibrateDone : BOOL;
	test : REAL;
END_VAR
VAR
	startCalibrate : BOOL;
	RTRIG_startCalibrate : R_TRIG;
	RTRIG_requireCalibration : R_TRIG;
	controlState : INT;
	TOF_Calibration : TOF;
	closeCommand : BOOL;
	
	openvalve : FB_Runtime;//(resetToTime := T#0S);
	closevalve : FB_Runtime;//(resetToTime := TO_TIME(controlValveParameters.timeToFullyOpenMs));
	start : BOOL;
	setvalve : BOOL;
	open : BOOL;
	close : BOOL;
	
	_testMode : BOOL;
	_testParams : ST_ControlValveStateMachineTest;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Read commands from ui
startCalibrate := controlValveCommands.calibrate;
RTRIG_startCalibrate(CLK := startCalibrate OR startCalibrationExternal);
RTRIG_requireCalibration(CLK := controlValveCommands.requireCalibration);

CASE controlState OF 
	
	0: // Before calibration
		closeCommand := FALSE;
		calibrateDone := FALSE;
		IF RTRIG_startCalibrate.Q THEN
			controlState := 1;
		END_IF
	
	1: // Calibrate
		TOF_Calibration(IN := startCalibrate, PT := TO_TIME(controlValveParameters.calibrationTimeMs));
		startCalibrate := FALSE;
		closeCommand := TRUE;
		IF controlValveCommands.stopCalibration THEN
			TOF_Calibration(IN := FALSE);
			startCalibrate := FALSE;
			controlState := 0;
		END_IF
		IF NOT TOF_Calibration.Q THEN
			TOF_Calibration(IN := TRUE);
			calibrateDone := TRUE;
			openvalve.resetValues();
			closevalve.resetValues();
			closeCommand := FALSE;
			controlState := 2;
		END_IF
	
	2: // Control
		// Calculate how long control valve should open/close
		
		openvalve(
				gotime := open, 
				settime := TO_TIME(controlValveParameters.timeToFullyOpenMs),
				resetToTime :=  T#0S,
				countdown := close, 
				elapsedtime => , elapsed => );
		closevalve(
				gotime := close, 
				settime := TO_TIME(controlValveParameters.timeToFullyOpenMs),
			 	resetToTime := TO_TIME(controlValveParameters.timeToFullyOpenMs),
				countdown := open, elapsedtime =>, 
				elapsed => );	
		IF controlValveCommands.openPercentage > currentControlValveOpenPercentage THEN
			open := TRUE;
			close := FALSE;
		ELSIF controlValveCommands.openPercentage < currentControlValveOpenPercentage THEN
			open := FALSE;
			close := TRUE;
		ELSE
			open := FALSE;
			close := FALSE;
		END_IF
		
		// Monitor calibrate command, return to calibration step
		IF RTRIG_startCalibrate.Q THEN
			controlState := 1;
		END_IF	
		// Return to pre-calibration step if stop issued
		IF RTRIG_requireCalibration.Q THEN
			controlState := 0;
			close := FALSE;
			open := FALSE;
			startCalibrate := FALSE;
		END_IF


END_CASE

// Calculate valve open-% according to open timer
IF controlValveParameters.timeToFullyOpenMs > 0 THEN
	currentControlValveOpenPercentage := TO_DINT(((TIME_TO_REAL(openvalve.elapsedtime)) /(controlValveParameters.timeToFullyOpenMs)*100));// TO_DINT(TIME_TO_REAL(openvalve.elapsedtime)/100);
	test := TO_DINT(TIME_TO_REAL(openvalve.elapsedtime));
END_IF

closeControlValve := closeCommand OR close;
openControlValve := open;


]]></ST>
    </Implementation>
    <Method Name="setTestMode" Id="{b3f335d9-0f88-426c-9e47-9c4d3e721eb4}">
      <Declaration><![CDATA[METHOD setTestMode : BOOL
VAR_INPUT
	testParams : ST_ControlValveStateMachineTest;
	reset : BOOL;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[
_testMode := TRUE;
_testParams := testParams;

IF reset THEN
	controlState := 0;
	closeControlValve := 0;
	openControlValve := 0;
	currentControlValveOpenPercentage := 0;
	calibrateDone := 0;	
	open := 0;
	close := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
