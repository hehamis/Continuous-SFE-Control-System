<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="ParameterViewBindings" Id="{26036d62-e7e5-4820-8b8f-a5aa825cf944}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM ParameterViewBindings
VAR_OUTPUT
	reactorTemperaturePidParameters : ST_PidParameters;
	autoExtractionParameters : ST_AutomaticExtractionParameters;
	extractionValveParameters : ST_ExtractiveControlValveParameters;
	pressureIntervals : ST_PressureIntervals;
	onOffValvePressureLimit : DINT;
	flowControlParameters : ST_FlowControlParameters;
END_VAR
VAR PERSISTENT
	PbTextField_TextVariable : INT := 9;
	TiTextField_TextVariable : INT := 300;
	TdTextField_TextVariable : INT := 900;
	IterationTimeTextField_TextVariable : INT := 6;
	BiasTextField_TextVariable : INT;
	
	controlValveOpeningValueTextField_TextVariable : DINT := 50;
	refillIntervalTextField_TextVariable : DINT := 300;
	pumpOnTimeTextField_TextVariable : DINT := 15;
	pumpSetpointWaitTimeTextField_TextVariable : DINT;
	refillPumpWaitTimeTextField_TextVariable : DINT := 5;
	
	calibrationTimeTextField_TextVariable : DINT := 26000;
	fullOpenTimeTextField_TextVariable : DINT := 26000;
	onOffValvePressureLimitTextField_TextVariable : DINT := 35;
	
	UpperIntervalSlurryOnUpperTextField_TextVariable : INT := 40;
	UpperIntervalSlurryOnNotUpperTextField_TextVariable : INT;
	UpperIntervalSlurryOffUpperTextField_TextVariable : INT;
	LowerIntervalSlurryOnUpperTextField_TextVariable : INT;
	LowerIntervalSlurryOnNotUpperTextField_TextVariable : INT;
	LowerIntervalSlurryOffUpperTextField_TextVariable : INT;	
	
	movingAvgIntervalTextField_TextVariable : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Send Reactor PID parameters to controller
reactorTemperaturePidParameters.PB := PbTextField_TextVariable;
reactorTemperaturePidParameters.Ti := TiTextField_TextVariable;
reactorTemperaturePidParameters.Td := TdTextField_TextVariable;
reactorTemperaturePidParameters.Iterationtime := IterationTimeTextField_TextVariable;
reactorTemperaturePidParameters.Bias := BiasTextField_TextVariable;
ReactorTemperatureController.pidControllerParameters := reactorTemperaturePidParameters;

// Send auto extraction parameters to controller
autoExtractionParameters.controlValveOpeningValue := controlValveOpeningValueTextField_TextVariable;
autoExtractionParameters.fillingTime := refillIntervalTextField_TextVariable;
autoExtractionParameters.pumpOnTime := pumpOnTimeTextField_TextVariable;
autoExtractionParameters.pumpSetpointWaitTime := pumpSetpointWaitTimeTextField_TextVariable;
autoExtractionParameters.pumpWaitTime := refillPumpWaitTimeTextField_TextVariable;
ReactorLevelAndPressureController.AutomaticExtractionParameters := autoExtractionParameters; 

// Slurry outlet pressure intervals
PressureIntervals.PressureUpperInterVal_1 := UpperIntervalSlurryOnUpperTextField_TextVariable;
PressureIntervals.PressureUpperInterVal_2 := UpperIntervalSlurryOnNotUpperTextField_TextVariable;
PressureIntervals.PressureUpperInterVal_3 := UpperIntervalSlurryOffUpperTextField_TextVariable;
PressureIntervals.PressureLowerInterval_1 := LowerIntervalSlurryOnUpperTextField_TextVariable;
PressureIntervals.PressureLowerInterval_2 := LowerIntervalSlurryOnNotUpperTextField_TextVariable;
PressureIntervals.PressureLowerInterval_3 := LowerIntervalSlurryOffUpperTextField_TextVariable;
ReactorLevelAndPressureController.PressureIntervals := PressureIntervals;

// Send extraction valve parameters to controller
extractionValveParameters.calibrationTimeMs := calibrationTimeTextField_TextVariable;
extractionValveParameters.timeToFullyOpenMs := fullOpenTimeTextField_TextVariable;
ReactorLevelAndPressureController.ExtractiveControlValveParameters := extractionValveParameters;

// On/off valve pressure limit
onOffValvePressureLimit := onOffValvePressureLimitTextField_TextVariable;

// Flow control parameters

flowControlParameters.movingAvgDurationSecs := movingAvgIntervalTextField_TextVariable;]]></ST>
    </Implementation>
    <LineIds Name="ParameterViewBindings">
      <LineId Id="71" Count="0" />
