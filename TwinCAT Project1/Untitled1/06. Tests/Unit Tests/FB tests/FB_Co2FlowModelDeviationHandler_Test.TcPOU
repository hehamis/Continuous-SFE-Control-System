<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_Co2FlowModelDeviationHandler_Test" Id="{407484c1-978e-4997-9568-2e90a7c2d575}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Co2FlowModelDeviationHandler_Test EXTENDS TcUnit.FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
simpleCalculationsTest();
ifCurrentFlowIsZeroDeviationShouldBeZero();]]></ST>
    </Implementation>
    <Method Name="ifCurrentFlowIsZeroDeviationShouldBeZero" Id="{023710b0-6f05-480c-b963-61f12cf694ca}">
      <Declaration><![CDATA[METHOD ifCurrentFlowIsZeroDeviationShouldBeZero
VAR
	deviationHandler : FB_Co2FlowModelDeviationHandler(maxValue := 100);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('ifCurrentFlowIsZeroDeviationShouldBeZero');

deviationHandler(
			currentFlow := 0,
			modeledFlow := 50);
					
AssertEquals_DINT(Expected := 0, Actual := deviationHandler.deviationPercentage, Message := 'Deviation not zero when current flow is zero');

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="simpleCalculationsTest" Id="{0b4270b5-cae7-4a2b-be5e-43be70b58fdb}">
      <Declaration><![CDATA[METHOD simpleCalculationsTest
VAR
	deviationHandler : FB_Co2FlowModelDeviationHandler(maxValue := 100);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('deviationShouldBeMinus50');

deviationHandler(
			currentFlow := 100,
			modeledFlow := 50);
					
AssertEquals_DINT(Expected := -50, Actual := deviationHandler.deviationPercentage, Message := 'Deviation not -50 when it should be');

TEST_FINISHED();

TEST('deviationShouldBePlus20');

deviationHandler(
			currentFlow := 100,
			modeledFlow := 120);
					
AssertEquals_DINT(Expected := 20, Actual := deviationHandler.deviationPercentage, Message := 'Deviation not 20 when it should be');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_Co2FlowModelDeviationHandler_Test">
