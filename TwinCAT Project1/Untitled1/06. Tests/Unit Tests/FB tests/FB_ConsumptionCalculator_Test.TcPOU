<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_ConsumptionCalculator_Test" Id="{415b15cd-58e6-4361-a77a-74917d733089}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ConsumptionCalculator_Test EXTENDS TcUnit.FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[theCalculatedValueShouldBeTenAfterTenSeconds();
theCalculatedValueShouldBe20After20Seconds();
theCalulatedValueShouldBe30After20Seconds();]]></ST>
    </Implementation>
    <Method Name="theCalculatedValueShouldBe20After20Seconds" Id="{44ae8914-d381-4f21-9d80-9f7071169b99}">
      <Declaration><![CDATA[METHOD theCalculatedValueShouldBe20After20Seconds
VAR
	consumptionCalc : FB_ConsumptionCalculator;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('theCalculatedValueShouldBe20After20Seconds');

consumptionCalc.calculate(
						start := TRUE,
						valuePerSec := 1,
						intervalS := 10,
						dtime := T#10S);
consumptionCalc.sum;								
consumptionCalc.calculate(
						start := TRUE,
						valuePerSec := 1,
						intervalS := 10,
						dtime := T#10S);
consumptionCalc.sum;			
						
AssertEquals_REAL(Expected := 20, Actual := consumptionCalc.sum, Delta := 0, Message := 'Calculated value not twenty after twenty seconds');

consumptionCalc.reset();
AssertEquals_REAL(Expected := 0, Actual := consumptionCalc.sum, Delta := 0, Message := 'Calculated value not reset');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="theCalculatedValueShouldBeTenAfterTenSeconds" Id="{e5d94e70-1220-44b7-91d9-67d13b095137}">
      <Declaration><![CDATA[METHOD theCalculatedValueShouldBeTenAfterTenSeconds : BOOL
VAR
	consumptionCalc : FB_ConsumptionCalculator;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('theCalculatedValueShouldBeTenAfterTenSeconds');
consumptionCalc.calculate(
						start := TRUE,
						valuePerSec := 0,
						intervalS := 10,
						dtime := T#10MS);
	
consumptionCalc.sum;						
consumptionCalc.calculate(
						start := TRUE,
						valuePerSec := 1,
						intervalS := 10,
						dtime := T#10S);
consumptionCalc.sum;
						
AssertEquals_REAL(Expected := 10, Actual := consumptionCalc.sum, Delta := 0, Message := 'Calculated value not ten after ten seconds');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="theCalulatedValueShouldBe30After20Seconds" Id="{f7615408-49e6-41a0-a48b-6152befbed95}">
      <Declaration><![CDATA[METHOD theCalulatedValueShouldBe30After20Seconds
VAR
	consumptionCalc : FB_ConsumptionCalculator;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('theCalulatedValueShouldBe30After20Seconds');

consumptionCalc.calculate(
						start := TRUE,
						valuePerSec := 1,
						intervalS := 10,
						dtime := T#10S);
						
consumptionCalc.calculate(
						start := TRUE,
						valuePerSec := 2,
						intervalS := 10,
						dtime := T#10S);

AssertEquals_REAL(Expected := 30, Actual := consumptionCalc.sum, Delta := 0, Message := 'Calculated value not 30 after twenty seconds');


TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
