<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_ControlValveStateMachine_Test" Id="{e00c1b53-1590-460a-802c-896740d7689b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ControlValveStateMachine_Test EXTENDS TcUnit.FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
calibrationTests();
normalControlTests();]]></ST>
    </Implementation>
    <Method Name="calibrationTests" Id="{529b1ad5-74aa-433f-89c7-e5ff4885ce97}">
      <Declaration><![CDATA[METHOD calibrationTests
VAR
	stateMachine : FB_ControlValveStateMachine;
	testParams : ST_ControlValveStateMachineTest;
	valveCommands : ST_ExtractiveControlValveCommands;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('1.1 control valve should close when calibration is initiated');

	valveCommands.calibrate := TRUE;

    // Reset FB
    stateMachine.setTestMode(
		testParams := testParams,
		reset := TRUE);
	
    // Initiate calibration
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
		
	stateMachine();

    AssertEquals_BOOL(
        Expected := TRUE,
        Actual := stateMachine.closeControlValve,
        Message := 'Control valve should close when calibration is initiated'
    );

    AssertEquals_BOOL(
        Expected := FALSE,
        Actual := stateMachine.openControlValve,
        Message := 'Control valve should not open during calibration'
    );

TEST_FINISHED();

TEST('1.2 calibration should remain active until calibration timer expires');

    testParams.calibrationTimerDone := FALSE;
	valveCommands.calibrate := TRUE;
	
    stateMachine.setTestMode(
        testParams := testParams,
        reset := TRUE
    );

	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    stateMachine();

	stateMachine(
		controlValveCommands:= , 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
		
//    stateMachine();

    AssertEquals_BOOL(
        Expected := TRUE,
        Actual := stateMachine.closeControlValve,
        Message := 'Control valve should remain closed during calibration'
    );

    AssertEquals_BOOL(
        Expected := FALSE,
        Actual := stateMachine.calibrateDone,
        Message := 'Calibration should not be completed before timer expires'
    );

TEST_FINISHED();

TEST('1.3 calibration should finish when calibration timer expires');

    testParams.calibrationTimerDone := TRUE;
	valveCommands.calibrate := TRUE;
	
    stateMachine.setTestMode(
        testParams := testParams,
        reset := TRUE
    );

	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
    stateMachine();

    valveCommands.calibrate := FALSE;
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    // Execute calibration state
    stateMachine();

    AssertEquals_BOOL(
        Expected := TRUE,
        Actual := stateMachine.calibrateDone,
        Message := 'Calibration should be completed when timer expires'
    );

    AssertEquals_BOOL(
        Expected := FALSE,
        Actual := stateMachine.closeControlValve,
        Message := 'Control valve should stop closing after calibration'
    );

TEST_FINISHED();

TEST('1.4 calibration should stop when stopCalibration command is issued');

    testParams.calibrationTimerDone := FALSE;

    stateMachine.setTestMode(
        testParams := testParams,
        reset := TRUE
    );

    valveCommands.calibrate := TRUE;
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
		
    stateMachine();

    valveCommands.calibrate := FALSE;
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
    stateMachine();

    valveCommands.stopCalibration := TRUE;
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
    stateMachine();

    valveCommands.stopCalibration := FALSE;
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    // Execute one more cycle to allow state 0 to execute
    stateMachine();

    AssertEquals_BOOL(
        Expected := FALSE,
        Actual := stateMachine.closeControlValve,
        Message := 'Control valve should stop closing when calibration is stopped'
    );

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="normalControlTests" Id="{50926892-29e7-44c4-ac5a-689746fb471f}">
      <Declaration><![CDATA[METHOD normalControlTests
VAR
	stateMachine : FB_ControlValveStateMachine;
	testParams : ST_ControlValveStateMachineTest;
	valveCommands : ST_ExtractiveControlValveCommands;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('control valve should open when requested percentage is higher than current percentage');

    // Enter control state through calibration
    testParams.calibrationTimerDone := TRUE;
    // Request 50% opening
    ValveCommands.openPercentage := 50;

    stateMachine.setTestMode(
        testParams := testParams,
        reset := TRUE
    );

    valveCommands.calibrate := TRUE;
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );


    valveCommands.calibrate := FALSE;
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    // Simulate current position of 25%
 	testParams.simulatedOpeningPercentage := 25;
    stateMachine.setTestMode(
        testParams := testParams,
        reset := FALSE);
	stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    AssertEquals_BOOL(
        Expected := TRUE,
        Actual := stateMachine.openControlValve,
        Message := 'Control valve should open when requested percentage is higher'
    );

    AssertEquals_BOOL(
        Expected := FALSE,
        Actual := stateMachine.closeControlValve,
        Message := 'Control valve should not close when requested percentage is higher'
    );

TEST_FINISHED();

TEST('control valve should close when requested percentage is lower than current percentage');

    // Enter control state through calibration
    testParams.calibrationTimerDone := TRUE;

    stateMachine.setTestMode(
        testParams := testParams,
        reset := TRUE
    );

    valveCommands.calibrate := TRUE;
    stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    valveCommands.calibrate := FALSE;
    stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    // Simulate current position of 75%
    testParams.simulatedOpeningPercentage := 75;
    stateMachine.setTestMode(
        testParams := testParams,
        reset := FALSE);

    // Request 25% opening
    valveCommands.openPercentage := 25;

    stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
		
    stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    AssertEquals_BOOL(
        Expected := FALSE,
        Actual := stateMachine.openControlValve,
        Message := 'Control valve should not open when requested percentage is lower'
    );

    AssertEquals_BOOL(
        Expected := TRUE,
        Actual := stateMachine.closeControlValve,
        Message := 'Control valve should close when requested percentage is lower'
    );

TEST_FINISHED();

TEST('control valve should remain stationary when requested percentage equals current percentage');

    testParams.calibrationTimerDone := TRUE;

    stateMachine.setTestMode(
        testParams := testParams,
        reset := TRUE
    );

    valveCommands.calibrate := TRUE;
    stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    valveCommands.calibrate := FALSE;
    stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );

    // Current position = 50%
    testParams.simulatedOpeningPercentage := 50;
    stateMachine.setTestMode(
        testParams := testParams,
        reset := FALSE,
    );

    // Requested position = 50%
    valveCommands.openPercentage := 50;
    stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
    stateMachine(
		controlValveCommands:= valveCommands, 
		controlValveParameters:= , 
		startCalibrationExternal:= , 
		closeControlValve=> , 
		openControlValve=> , 
		currentControlValveOpenPercentage=> , 
		calibrateDone=> );
    AssertEquals_BOOL(
        Expected := FALSE,
        Actual := stateMachine.openControlValve OR stateMachine.closeControlValve,
        Message := 'Neither valve command should be active when target position is reached'
    );

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
