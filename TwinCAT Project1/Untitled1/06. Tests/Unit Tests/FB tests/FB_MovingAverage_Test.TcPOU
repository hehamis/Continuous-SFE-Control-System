<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_MovingAverage_Test" Id="{2f19abed-84d4-48fe-930a-61fce21e2a0f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MovingAverage_Test EXTENDS TcUnit.FB_TestSuite]]></Declaration>
    <Implementation>
      <ST><![CDATA[calculationShouldBeReadyWhenTimePassed();
calculationShouldNotBeReadyBeforeTimePassed();
movingAverageOfThreePlusTwoPlusOneShouldBeTwo();
resetMethodCallShouldResetValue();
theValueShouldBe40AfterTwoSeconds();
valueShouldBe0BeforeWindowPassedIfPreReadyNotIncluded();]]></ST>
    </Implementation>
    <Method Name="calculationShouldBeReadyWhenTimePassed" Id="{191212e6-4fc8-4265-bb95-62915115aacc}">
      <Declaration><![CDATA[METHOD calculationShouldBeReadyWhenTimePassed : BOOL
VAR
	movingAverage : FB_MovingAverage;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('calculationShouldBeReadyWhenTimePassed');
movingAverage.startCalculation(TRUE,0, 3,1, T#3S, FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual :=  movingAverage.ready, Message := 'Moving average calculation not ready after time passed');
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="calculationShouldNotBeReadyBeforeTimePassed" Id="{0f72b63f-fd9f-47d6-819b-ef24d985cb05}">
      <Declaration><![CDATA[METHOD calculationShouldNotBeReadyBeforeTimePassed : BOOL
VAR
	movingAverage : FB_MovingAverage;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('calculationShouldNotBeReadyBeforeTimePassed');
movingAverage.startCalculation(TRUE, 0, 1,1, T#0S, FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual :=  movingAverage.ready, Message := 'Moving average calculation ready before time passed');
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="movingAverageOfThreePlusTwoPlusOneShouldBeTwo" Id="{b9507e38-3aba-4d26-bc53-9f4ae707268f}">
      <Declaration><![CDATA[METHOD movingAverageOfThreePlusTwoPlusOneShouldBeTwo
VAR
	movingAverage : FB_MovingAverage;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('movingAverageOfThreePlusTwoPlusOneShouldBeTwo');
movingAverage.startCalculation(TRUE, 3, 3, 1, T#1S, FALSE);
movingAverage.startCalculation(TRUE, 2, 3, 1, T#1S, FALSE);
movingAverage.startCalculation(TRUE, 1, 3, 1, T#1S, FALSE);
movingAverage.startCalculation(TRUE, 0, 3, 1, T#1S, FALSE);
AssertEquals_REAL(Expected := 2, Actual := movingAverage.value, 0, Message := 'Moving average calculation not equal to two!');
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="resetMethodCallShouldResetValue" Id="{a712c06f-d26e-4670-bdb3-b535903dbd74}">
      <Declaration><![CDATA[METHOD resetMethodCallShouldResetValue
VAR
	movingAverage : FB_MovingAverage;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('resetMethodCallShouldResetValue');
movingAverage.startCalculation(start := TRUE, measurement := 50, intervalS := 1, windowS := 3, dtime := T#3S, excludeUntilReady := FALSE);
movingAverage.reset();
AssertEquals_REAL(0, movingAverage.value, 0, 'Reset did not reset value!'); 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="theValueShouldBe40AfterTwoSeconds" Id="{6d1812bd-834f-47d8-8609-a5c345ed96bf}">
      <Declaration><![CDATA[METHOD theValueShouldBe40AfterTwoSeconds
VAR
	movingAverage : FB_MovingAverage;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('theValueShouldBe40AfterTwoSeconds');
movingAverage.startCalculation(start := TRUE, measurement := 40, intervalS := 1, windowS := 3, dtime := T#1S, excludeUntilReady := FALSE);
movingAverage.startCalculation(start := TRUE, measurement := 40, intervalS := 1, windowS := 3, dtime := T#1S, excludeUntilReady := FALSE);
AssertEquals_REAL(40, movingAverage.value, 0, 'Value not 40 after two seconds'); 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="valueShouldBe0BeforeWindowPassedIfPreReadyNotIncluded" Id="{c81eda91-7c4d-4094-bd68-f8838112ac65}">
      <Declaration><![CDATA[METHOD valueShouldBe0BeforeWindowPassedIfPreReadyNotIncluded
VAR
	movingAverage : FB_MovingAverage;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
TEST('valueShouldBe0BeforeWindowPassedIfPreReadyNotIncluded');
movingAverage.startCalculation(start := TRUE, measurement := 40, intervalS := 1, windowS := 3, dtime := T#1S, excludeUntilReady := TRUE);
movingAverage.startCalculation(start := TRUE, measurement := 40, intervalS := 1, windowS := 3, dtime := T#1S, excludeUntilReady := TRUE);
AssertEquals_REAL(0, movingAverage.value, 0, 'Value not 0 before window passed when exclude values before first window checked'); 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
