<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="TON_Mock_TimerRanOut" Id="{7d6d4868-3559-4333-9eae-993ffbb1ee46}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TON_Mock_TimerRanOut IMPLEMENTS I_TON
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
    _mockQ : BOOL := TRUE;
    _mockET : TIME := T#0S;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Call" Id="{6145eda0-457a-4776-b2af-60b08424d27c}">
      <Declaration><![CDATA[ 
METHOD Call : BOOL
VAR_INPUT
	IN	: BOOL;
	PT	: TIME;
END_VAR
VAR_OUTPUT
	Q : BOOL;
	ET : TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Simulate timer behavior for unit testing
IF IN THEN
	_mockQ := TRUE;  // Simulate timer has finished
ELSE
	_mockQ := FALSE;
END_IF
_mockET := PT;  // Pretend elapsed time matches preset
Q := _mockQ;
ET := _mockET;]]></ST>
      </Implementation>
    </Method>
